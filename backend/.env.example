# Django Settings
DJANGO_SECRET_KEY=your-secret-key-here-change-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database (leave empty to use local SQLite; set to a Postgres URL in deployed envs)
DATABASE_URL=

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# CSRF — REQUIRED in production (Railway/Heroku-style proxy). Full origin(s)
# with scheme, comma-separated. Must include the backend's own public URL
# (it's what serves the /admin/ login form) — e.g. https://your-backend.up.railway.app
CSRF_TRUSTED_ORIGINS=

# Pix copia-e-cola — REQUIRED real values before deploying (payments go nowhere without them)
PIX_KEY=
PIX_MERCHANT_NAME=
PIX_MERCHANT_CITY=

# Supabase Storage (comprovantes) — REQUIRED before deploying.
# SUPABASE_SERVICE_ROLE_KEY: Supabase dashboard > Project Settings > API > service_role key.
# Never commit this value; never expose it to the frontend.
SUPABASE_URL=https://lejvzbsgkznomumekscl.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# E-mail (ingresso). Leave RESEND_API_KEY empty to use the console backend locally.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=ingressos@fireconference.local
RESEND_API_KEY=

# Bootstrap do primeiro admin — opcional. Se ambos estiverem preenchidos e não
# existir usuário com esse e-mail, a migration users.0002 cria um superuser
# automaticamente no próximo `migrate`. Não deixe preenchido depois do primeiro
# uso (evita recriar/expor a senha em texto puro na config do ambiente).
DJANGO_ADMIN_EMAIL=
DJANGO_ADMIN_PASSWORD=
